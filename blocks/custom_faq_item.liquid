
<div class="custom-faq-item" {{ block.shopify_attributes }}>
  <h3>{{ block.settings.question }}</h3>
  <p>{{ block.settings.answer }}</p>
</div>

{% schema %}
{
  "name": "FAQ Item",
  "settings": [
    {
      "type": "text",
      "id": "question",
      "label": "Question",
      "default": "What products do you offer?"
    },
    {
      "type": "text",
      "id": "answer",
      "label": "Answer",
      "default": "We offer a variety of skincare products."
    }
  ],
  "presets": [
    {
      "name": "FAQ Item"
    }
  ]
}
{% endschema %}
