
<details class="custom-faq-item" {{ block.shopify_attributes }}>
  <summary class="custom-faq-question">
    <span>{{ block.settings.question | escape }}</span>
    <span class="custom-faq-icon" aria-hidden="true">
      <span></span>
      <span></span>
    </span>
  </summary>
  <div class="custom-faq-answer">
    {{ block.settings.answer | escape }}
  </div>
</details>

<style>
  .custom-faq-item {
    border-top: 1px solid #eadfe3;
  }

  .custom-faq-item:first-child {
    border-top: 0;
  }

  .custom-faq-question {
    min-height: 64px;
    padding: 16px 2.5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    list-style: none;
    cursor: pointer;
    color: #9d0740;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 12px;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .custom-faq-question::-webkit-details-marker {
    display: none;
  }

  .custom-faq-icon {
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
    border: 1.5px solid #9d0740;
    border-radius: 50%;
    position: relative;
  }

  .custom-faq-icon span {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 12.5px;
    height: 1.5px;
    background: #9d0740;
  }

  .custom-faq-icon span:last-child {
    transform: rotate(90deg);
    transition: transform 180ms ease;
  }

  .custom-faq-item[open] .custom-faq-icon span:last-child {
    transform: rotate(0);
  }

  .custom-faq-answer {
    padding: 0 2.5% 18px;
    color: #2f292b;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 13px;
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .custom-faq-question {
      min-height: 72px;
      padding-left: 2.5%;
      padding-right: 2.5%;
      font-size: 12px;
    }

    .custom-faq-answer {
      padding-left: 2.5%;
      padding-right: 2.5%;
    }
  }
</style>

{% schema %}
{
  "name": "FAQ Item",
  "settings": [
    {
      "type": "text",
      "id": "question",
      "label": "Question",
      "default": "What products do you offer?"
    },
    {
      "type": "text",
      "id": "answer",
      "label": "Answer",
      "default": "We offer a variety of skincare products."
    }
  ],
  "presets": [
    {
      "name": "FAQ Item"
    }
  ]
}
{% endschema %}
