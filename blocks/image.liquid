{% render 'theme-image-block', block: block %}

{% schema %}
{
  "name": "t:blocks.image.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:blocks.image.settings.image.label",
      "default": { "url": "no-image-59606643991319.webp", "enable_customisation": true }
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.image.settings.link.label",
      "default": { "display_name": "t:blocks.image.settings.link.default", "handle": "" }
    },
    {
      "type": "header",
      "content": "t:blocks.image.settings.size_header.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:blocks.image.settings.image_ratio.label",
      "default": { "display_name": "t:blocks.image.settings.image_ratio.default", "value": "adapt" },
      "options": [
        { "label": "t:blocks.image.settings.image_ratio.options.adapt.label", "value": "adapt" },
        { "label": "t:blocks.image.settings.image_ratio.options.portrait.label", "value": "portrait" },
        { "label": "t:blocks.image.settings.image_ratio.options.square.label", "value": "square" },
        { "label": "t:blocks.image.settings.image_ratio.options.landscape.label", "value": "landscape" }
      ]
    },
    {
      "type": "radio",
      "id": "width",
      "label": "t:blocks.image.settings.width.label",
      "default": { "display_name": "t:blocks.image.settings.width.default", "value": "fill" },
      "meta": "desktop",
      "options": [
        { "label": "t:blocks.image.settings.width.options.fit_content.label", "value": "fit-content" },
        { "label": "t:blocks.image.settings.width.options.fill.label", "value": "fill" },
        { "label": "t:blocks.image.settings.width.options.custom.label", "value": "custom" }
      ]
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:blocks.image.settings.custom_width.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "meta": "desktop",
      "visible_if": "{{ block.settings.width.value == 'custom' }}"
    },
    {
      "type": "radio",
      "id": "width_mobile",
      "label": "t:blocks.image.settings.width_mobile.label",
      "default": { "display_name": "t:blocks.image.settings.width_mobile.default", "value": "fill" },
      "meta": "mobile",
      "options": [
        { "label": "t:blocks.image.settings.width_mobile.options.fit_content.label", "value": "fit-content" },
        { "label": "t:blocks.image.settings.width_mobile.options.fill.label", "value": "fill" },
        { "label": "t:blocks.image.settings.width_mobile.options.custom.label", "value": "custom" }
      ]
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:blocks.image.settings.custom_width_mobile.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "meta": "mobile",
      "visible_if": "{{ block.settings.width_mobile.value == 'custom' }}"
    },
    {
      "type": "radio",
      "id": "height",
      "label": "t:blocks.image.settings.height.label",
      "default": { "display_name": "t:blocks.image.settings.height.default", "value": "fit" },
      "options": [
        { "label": "t:blocks.image.settings.height.options.fit.label", "value": "fit" },
        { "label": "t:blocks.image.settings.height.options.fill.label", "value": "fill" }
      ],
      "visible_if": "{{ block.settings.image_ratio.value == 'adapt' }}"
    },
    {
      "type": "header",
      "content": "t:blocks.image.settings.padding_header.content"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "t:blocks.image.settings.padding_block_start.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "t:blocks.image.settings.padding_block_end.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_inline_start",
      "label": "t:blocks.image.settings.padding_inline_start.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_inline_end",
      "label": "t:blocks.image.settings.padding_inline_end.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    { "name": "t:blocks.image.presets.name" }
  ]
}
{% endschema %}
