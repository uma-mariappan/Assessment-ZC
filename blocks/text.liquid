{% render 'theme-text-block', block: block %}

{% schema %}
{
  "name": "t:blocks.text.name",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:blocks.text.settings.text.label",
      "default": "t:blocks.text.settings.text.default"
    },
    {
      "type": "radio",
      "id": "select_font_family",
      "label": "t:blocks.text.settings.select_font_family.label",
      "default": { "display_name": "t:blocks.text.settings.select_font_family.default", "value": "primary" },
      "options": [
        { "label": "t:blocks.text.settings.select_font_family.options.primary.label", "value": "primary" },
        { "label": "t:blocks.text.settings.select_font_family.options.secondary.label", "value": "secondary" }
      ]
    },
    {
      "type": "radio",
      "id": "select_text_color",
      "label": "t:blocks.text.settings.select_text_color.label",
      "default": { "display_name": "t:blocks.text.settings.select_text_color.default", "value": "body-text-color" },
      "options": [
        { "label": "t:blocks.text.settings.select_text_color.options.heading_text_color.label", "value": "heading-text-color" },
        { "label": "t:blocks.text.settings.select_text_color.options.body_text_color.label", "value": "body-text-color" },
        { "label": "t:blocks.text.settings.select_text_color.options.alt_text_color.label", "value": "alt-text-color" }
      ]
    },
    {
      "type": "radio",
      "id": "desktop_font_weight",
      "label": "t:blocks.text.settings.desktop_font_weight.label",
      "default": { "display_name": "t:blocks.text.settings.desktop_font_weight.options.medium.label", "value": "medium" },
      "meta": "desktop",
      "options": [
        { "label": "t:blocks.text.settings.desktop_font_weight.options.light.label", "value": "light" },
        { "label": "t:blocks.text.settings.desktop_font_weight.options.medium.label", "value": "medium" },
        { "label": "t:blocks.text.settings.desktop_font_weight.options.bold.label", "value": "bold" }
      ]
    },
    {
      "type": "radio",
      "id": "mobile_font_weight",
      "label": "t:blocks.text.settings.mobile_font_weight.label",
      "default": { "display_name": "t:blocks.text.settings.mobile_font_weight.options.medium.label", "value": "medium" },
      "meta": "mobile",
      "options": [
        { "label": "t:blocks.text.settings.mobile_font_weight.options.light.label", "value": "light" },
        { "label": "t:blocks.text.settings.mobile_font_weight.options.medium.label", "value": "medium" },
        { "label": "t:blocks.text.settings.mobile_font_weight.options.bold.label", "value": "bold" }
      ]
    },
    {
      "type": "select",
      "id": "desktop_text_size",
      "label": "t:blocks.text.settings.desktop_text_size.label",
      "default": { "display_name": "t:blocks.text.settings.desktop_text_size.default", "value": "text-base" },
      "meta": "desktop",
      "options": [
        { "label": "t:blocks.text.settings.desktop_text_size.options.text_8xl.label", "value": "text-8xl" },
        { "label": "t:blocks.text.settings.desktop_text_size.options.text_7xl.label", "value": "text-7xl" },
        { "label": "t:blocks.text.settings.desktop_text_size.options.text_6xl.label", "value": "text-6xl" },
        { "label": "t:blocks.text.settings.desktop_text_size.options.text_5xl.label", "value": "text-5xl" },
        { "label": "t:blocks.text.settings.desktop_text_size.options.text_4xl.label", "value": "text-4xl" },
        { "label": "t:blocks.text.settings.desktop_text_size.options.text_3xl.label", "value": "text-3xl" },
        { "label": "t:blocks.text.settings.desktop_text_size.options.text_2xl.label", "value": "text-2xl" },
        { "label": "t:blocks.text.settings.desktop_text_size.options.text_xl.label", "value": "text-xl" },
        { "label": "t:blocks.text.settings.desktop_text_size.options.text_lg.label", "value": "text-lg" },
        { "label": "t:blocks.text.settings.desktop_text_size.options.text_base.label", "value": "text-base" },
        { "label": "t:blocks.text.settings.desktop_text_size.options.text_sm.label", "value": "text-sm" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_text_size",
      "label": "t:blocks.text.settings.mobile_text_size.label",
      "default": { "display_name": "t:blocks.text.settings.mobile_text_size.default", "value": "text-base" },
      "meta": "mobile",
      "options": [
        { "label": "t:blocks.text.settings.mobile_text_size.options.text_6xl.label", "value": "text-6xl" },
        { "label": "t:blocks.text.settings.mobile_text_size.options.text_5xl.label", "value": "text-5xl" },
        { "label": "t:blocks.text.settings.mobile_text_size.options.text_4xl.label", "value": "text-4xl" },
        { "label": "t:blocks.text.settings.mobile_text_size.options.text_3xl.label", "value": "text-3xl" },
        { "label": "t:blocks.text.settings.mobile_text_size.options.text_2xl.label", "value": "text-2xl" },
        { "label": "t:blocks.text.settings.mobile_text_size.options.text_xl.label", "value": "text-xl" },
        { "label": "t:blocks.text.settings.mobile_text_size.options.text_lg.label", "value": "text-lg" },
        { "label": "t:blocks.text.settings.mobile_text_size.options.text_base.label", "value": "text-base" },
        { "label": "t:blocks.text.settings.mobile_text_size.options.text_sm.label", "value": "text-sm" }
      ]
    },
    {
      "type": "header",
      "content": "t:blocks.text.settings.padding_header.content"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "t:blocks.text.settings.padding_block_start.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "t:blocks.text.settings.padding_block_end.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_inline_start",
      "label": "t:blocks.text.settings.padding_inline_start.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_inline_end",
      "label": "t:blocks.text.settings.padding_inline_end.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:blocks.text.presets.heading.name",
      "settings": {
        "text": "t:blocks.text.presets.heading.settings.text",
        "select_font_family": {
          "display_name": "t:blocks.text.settings.select_font_family.options.primary.label",
          "value": "primary"
        },
        "select_text_color": {
          "display_name": "t:blocks.text.settings.select_text_color.options.heading_text_color.label",
          "value": "heading-text-color"
        },
        "desktop_font_weight": {
          "display_name": "Medium",
          "value": "medium"
        },
        "mobile_font_weight": {
          "display_name": "Medium",
          "value": "medium"
        },
        "desktop_text_size": {
          "display_name": "3XL",
          "value": "text-3xl"
        },
        "mobile_text_size": {
          "display_name": "XL",
          "value": "text-xl"
        },
        "padding_block_start": 0,
        "padding_block_end": 0,
        "padding_inline_start": 0,
        "padding_inline_end": 0
      }
    },
    {
      "name": "t:blocks.text.presets.text.name",
      "settings": {
        "text": "t:blocks.text.settings.text.default",
        "select_font_family": {
          "display_name": "t:blocks.text.settings.select_font_family.options.secondary.label",
          "value": "secondary"
        },
        "select_text_color": {
          "display_name": "t:blocks.text.settings.select_text_color.options.body_text_color.label",
          "value": "body-text-color"
        },
        "desktop_font_weight": {
          "display_name": "Light",
          "value": "light"
        },
        "mobile_font_weight": {
          "display_name": "Light",
          "value": "light"
        },
        "desktop_text_size": {
          "display_name": "XL",
          "value": "text-xl"
        },
        "mobile_text_size": {
          "display_name": "t:blocks.text.settings.mobile_text_size.options.text_base.label",
          "value": "text-base"
        },
        "padding_block_start": 0,
        "padding_block_end": 0,
        "padding_inline_start": 0,
        "padding_inline_end": 0
      }
    },
    {
      "name": "t:blocks.text.presets.jumbo_text.name",
      "settings": {
        "text": "t:blocks.text.presets.jumbo_text.settings.text",
        "select_font_family": {
          "display_name": "t:blocks.text.settings.select_font_family.options.primary.label",
          "value": "primary"
        },
        "select_text_color": {
          "display_name": "t:blocks.text.settings.select_text_color.options.heading_text_color.label",
          "value": "heading-text-color"
        },
        "desktop_font_weight": {
          "display_name": "Bold",
          "value": "bold"
        },
        "mobile_font_weight": {
          "display_name": "Bold",
          "value": "bold"
        },
        "desktop_text_size": {
          "display_name": "8XL",
          "value": "text-8xl"
        },
        "mobile_text_size": {
          "display_name": "t:blocks.text.settings.mobile_text_size.options.text_2xl.label",
          "value": "text-2xl"
        },
        "padding_block_start": 0,
        "padding_block_end": 0,
        "padding_inline_start": 0,
        "padding_inline_end": 0
      }
    }
  ]
}
