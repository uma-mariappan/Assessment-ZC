<!doctype html>
<html lang="en-us">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="utf-8">
    {% if store.favicon.url != blank and store.favicon.url != '?' %}
      {% assign fav_small = store.favicon.url %}
      {% for res in store.favicon.resolutions %}
        {% if res.format == "png" and res.width == 320 %}{% assign fav_small = res.url %}{% endif %}
      {% endfor %}
      <link rel="icon" type="image/png" sizes="any" href="{{ fav_small }}">
    {% endif %}
    <link rel="stylesheet" href="{{ "style-19486920188144.css" | asset_url }}">
    <link rel="stylesheet" href="{{ "theme-settings-898456141777185.css" | asset_url }}">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Arvo:wght@400;700&family=Cinzel:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700;800&family=Lora:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600;700;800&family=Poppins:wght@300;400;500;600;700;800&family=Roboto+Slab:wght@400;500;600;700&display=swap">
    <script type="module" src="{{ 'network-adapter-730892702895239.js' | asset_url }}" defer></script>
    <title>
      {{ page_title }}
      {% if store.name %}
        {% unless page_title contains store.name %}
          {% if page_title != blank %} &ndash; {% endif %} {{ store.name }}
        {% endunless %}
      {% endif %}
    </title>
    {{ content_for_header }}
  </head>
  <body>
    <a href="#mainContent" class="skip-to-content-link">{{ "common.skip_to_content" | t }}</a>
    <div class="w-[90%] mx-auto page-max-width flex flex-row justify-start py-6 md:py-8">
      {% if store.logo != null and store.logo != blank %}
        <a href="/home" class="flex items-center">
          {% assign logo_image = store.logo %}
          <picture class="block h-7 md:h-9">
            {% render 'image-resolutions', firstImage: logo_image %}
            <img src="{{ store.logo.url }}" class="h-7 md:h-9 w-auto" alt="{{ "common.alt_image" | t }}">
          </picture>
        </a>
      {% else %}
        <div class="flex flex-col items-center">
          <a href="/home" class="text-lg md:text-3xl">{{ store.name }}</a>
          <p class="text-sm md:text-base">{{ store.tag_line }}</p>
        </div>
      {% endif %}
    </div>

    <main id="mainContent" tabindex="-1" class="flex-grow flex flex-col">
      {{ content_for_layout }}
    </main>

    {% render 'theme-settings' %}
  </body>
</html>
