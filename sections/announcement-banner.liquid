
{% liquid
  assign announcement_alignment = section.settings.alignment.value | default: section.settings.alignment | default: 'center'
  if announcement_alignment == 'left'
    assign align_items = 'flex-start'
    assign text_align = 'left'
  elsif announcement_alignment == 'right'
    assign align_items = 'flex-end'
    assign text_align = 'right'
  else
    assign align_items = 'center'
    assign text_align = 'center'
  endif
%}

<div
  class="announcement-banner"
  style="
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  "
>
  <div class="announcement-banner__content" style="align-items: {{ align_items }}; text-align: {{ text_align }};">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.message != blank %}
      <p>{{ section.settings.message | escape }}</p>
    {% endif %}
  </div>
</div>

<style>
  .announcement-banner {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    width: 100%;
    height: 56px;
    padding: 8px 20px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0 0 8px 8px;
    overflow: hidden;
  }

  .announcement-banner__content {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-width: 0;
    animation: announcement-marquee 20s linear infinite;
  }

  @keyframes announcement-marquee {
    from {
      transform: translateX(-100%);
    }

    to {
      transform: translateX(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-banner__content {
      animation: none;
    }
  }

  .announcement-banner__content h2 {
    margin: 0;
    max-width: 100%;
    font-size: 15px;
    line-height: 18px;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .announcement-banner__content p {
    margin: 0;
    max-width: 100%;
    min-width: 0;
    font-size: 12px;
    line-height: 16px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 767px) {
    .announcement-banner {
      height: 56px;
      padding: 0 12px;
    }

    .announcement-banner__content {
      gap: 3px;
    }

    .announcement-banner__content h2 {
      font-size: 15px;
      line-height: 18px;
    }

    .announcement-banner__content p {
      font-size: 11px;
      line-height: 15px;
    }
  }
</style>

<script>
  (() => {
    const banner = document.querySelector('.announcement-banner');
    if (!banner) return;
    const height = banner.offsetHeight;

    document.documentElement.style.setProperty('--announcement-bar-height', `${height}px`);

    const header = document.querySelector('app-header');
    if (header) {
      header.style.top = `${height}px`;
      header.updateSpacerHeight?.();
    }

    window.addEventListener('resize', () => {
      const currentHeight = banner.offsetHeight;
      document.documentElement.style.setProperty('--announcement-bar-height', `${currentHeight}px`);

      if (header) {
        header.style.top = `${currentHeight}px`;
        header.updateSpacerHeight?.();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Announcement Banner",
  "available_in": {
    "templates": ["index"],
    "header-group": true
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Special Offers & Exclusive Discounts"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Announcement Message",
      "default": "Get 5% Extra Discount on Prepaid Orders | COD Available (T&C Apply)"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Colour",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Colour",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text Alignment",
      "default": {
        "display_name": "Center",
        "value": "center"
      },
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Banner",
      "settings": {
        "heading": "Special Offers & Exclusive Discounts",
        "message": "Get 5% Extra Discount on Prepaid Orders | COD Available (T&C Apply)",
        "background_color": "#000000",
        "text_color": "#FFFFFF",
        "alignment": {
          "display_name": "Center",
          "value": "center"
        }
      }
    }
  ]
}
{% endschema %}
