<script src="{{ 'blog-post-slider-568331365395164.js' | asset_url }}" defer></script>

{% style %}
  #section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }
  @media (min-width: 768px) {
    #section-{{ section.id }} {
      padding-top: {{ section.settings.desktop_padding_top }}px;
      padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    }
  }
  #section-{{ section.id }} [data-blog-post-track] {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  #section-{{ section.id }} [data-blog-post-track]::-webkit-scrollbar {
    display: none;
  }
  #section-{{ section.id }} .bp-scrollbar-track {
    background-color: rgba(var(--border-color), 0.2);
  }
  #section-{{ section.id }} .bp-scrollbar-thumb {
    background-color: var(--heading-text-color);
  }
{% endstyle %}

{% liquid
  assign section_settings = section.settings
  assign bp_bg_value = section_settings.background_color.value | default: section_settings.background_color | default: 'primary'
%}

<blog-post-slider id="section-{{ section.id }}" class="block w-full {% if bp_bg_value == 'secondary' %}bg-secondary-color{% else %}bg-primary-color{% endif %}">
  <div class="w-[90%] page-max-width mx-auto">
    <div class="flex flex-col gap-4 md:gap-6 items-start mb-10 md:mb-12">
      {% render_blocks %}
    </div>

    {% assign has_blog_card = false %}
    <div data-blog-post-instance>
      <div
        data-blog-post-track
        class="flex gap-4 md:gap-6 overflow-x-auto overflow-y-hidden pb-2 scroll-smooth snap-x snap-mandatory"
      >
        {% for perBlock in section.blocks %}
          {% if perBlock.type == 'blog-card' %}
            {% assign has_blog_card = true %}
            <article class="flex-shrink-0 snap-start w-[70vw] sm:w-[280px] md:w-[320px] lg:w-[333px] blog-card blog-card-color card overflow-hidden flex flex-col" {{ perBlock.zcommerce_attributes }}>
              {% render 'blog-post-card', blog_card_block: perBlock %}
            </article>
          {% endif %}
        {% endfor %}
      </div>

      {% if has_blog_card %}
        <div class="bp-scrollbar-track mt-6 h-[2px] relative hidden" data-blog-post-scrollbar>
          <div class="bp-scrollbar-thumb absolute top-0 left-0 h-[2px]" style="width: 40%; left: 0;" data-blog-post-scroll-thumb></div>
        </div>
      {% else %}
        <p class="text-center heading-text-color opacity-70 py-10">
          Add at least one Blog card block.
        </p>
      {% endif %}
    </div>
  </div>
</blog-post-slider>

