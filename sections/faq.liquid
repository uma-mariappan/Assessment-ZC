        "value": "top"
      }
    },
    {
      "type": "header",
      "content": "t:sections.faq.settings.section_padding.mobile",
      "meta": "mobile"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 30,
      "label": "t:sections.faq.settings.section_padding.top.label",
      "meta": "mobile"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
