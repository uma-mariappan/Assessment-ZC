{% style %}
  #section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }
  @media (min-width: 768px) {
    #section-{{ section.id }} {
      padding-top: {{ section.settings.desktop_padding_top }}px;
      padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    }
  }
{% endstyle %}

{% liquid
  assign section_settings = section.settings
  assign content_alignment = section_settings.content_alignment.value
%}

<section id="section-{{ section.id }}" class="w-full">
    <div class="lg:max-w-[1075px] mx-auto" style="padding-left: var(--section-padding-x, 16px); padding-right: var(--section-padding-x, 16px);">

      <div class="text-center {% if content_alignment == 'top' %} pb-8 md:pb-10 {% else %} pb-6 {% endif %}">
        {% render_blocks type: "zc_theme__text" %}
      </div>

      <div class="flex flex-col gap-4 lg:max-w-[1075px] {% if content_alignment == 'top' %} mx-auto {% endif %}">
        {% render_blocks type: "zc_theme__accordion" %}
      </div>

    </div>
  </section>

{% schema %}
{
  "name": "t:sections.faq.name",
  "tag": "section",
  "class": "section",
  "category": "Faq",
  "available_in": {
