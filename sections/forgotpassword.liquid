{% style %}
  #section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }
  @media (min-width: 768px) {
    #section-{{ section.id }} {
      padding-top: {{ section.settings.desktop_padding_top }}px;
      padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    }
  }
{% endstyle %}

<div id="section-{{ section.id }}">
    <div class="user-signup-container">
        <div class="user-signup-form-area">
            <iframe title="Forgot password form" src="{{ store.customer_portal.forgot_password_url }}&css_url={{ "signin-424024153007789.css" | asset_path }}"
                class="block w-full md:w-100"
                style="border: none; height: 208px; overflow-x:hidden; overflow-y:hidden !important; margin:0 auto;"></iframe>
        </div>
        <div class="text-base">
            <a href="/signin" class="self-start">Back to Sign In</a>
        </div>
    </div>
</div>

{% schema %}
{
  "name": "t:sections.forgotpassword.name",
  "available_in": { "templates": ["page"] },
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.forgotpassword.settings.section_padding.mobile",
      "meta": "mobile"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 30,
      "label": "t:sections.forgotpassword.settings.section_padding.top.label",
      "meta": "mobile"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 30,
      "label": "t:sections.forgotpassword.settings.section_padding.bottom.label",
      "meta": "mobile"
    },
    {
      "type": "header",
      "content": "t:sections.forgotpassword.settings.section_padding.desktop",
      "meta": "desktop"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30,
      "label": "t:sections.forgotpassword.settings.section_padding.top.label",
      "meta": "desktop"
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30,
      "label": "t:sections.forgotpassword.settings.section_padding.bottom.label",
      "meta": "desktop"
    }
  ],
  "presets": [{ "name": "t:sections.forgotpassword.presets.default.name" }]
}
{% endschema %}