{% liquid
  assign section_settings = section.settings
  assign carousel_index = -1
  assign image_block_count = 0

  for per_block in section.blocks
    if per_block.type == 'zc_theme__carousel'
      assign carousel_index = forloop.index0
    endif
    if per_block.type == 'zc_theme__image'
      assign image_block_count = image_block_count | plus: 1
    endif
  endfor

  assign carousel_mobile_order = 2
  if image_block_count == 0
    assign carousel_mobile_order = 1
  endif
%}

{% style %}
  #section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }
  @media (min-width: 768px) {
    #section-{{ section.id }} {
      padding-top: {{ section.settings.desktop_padding_top }}px;
      padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    }
  }
  #section-{{ section.id }} .hero-image-panel {
    height: 100%;
  }
  #section-{{ section.id }} .hero-image-panel .image-block {
    height: 100%;
  }
  #section-{{ section.id }} a.overflow-hidden:focus-visible {
    outline-offset: -3px;
  }
{% endstyle %}

<section id="section-{{ section.id }}" class="w-full {% if section_settings.background_color.value == 'secondary' or section_settings.background_color == 'secondary' %}bg-secondary-color{% endif %}">
  <div class="w-full h-auto md:h-[770px]">
    <div class="flex flex-col md:flex-row items-stretch h-full w-full md:overflow-hidden">
      {% if image_block_count > 0 %}
        <div class="flex flex-row md:contents w-full h-[317px] md:h-auto order-1 md:order-none">
          {% for per_block in section.blocks %}
            {% if per_block.type == 'zc_theme__image' %}
              {% liquid
                assign panel_position = 'left'
                if carousel_index >= 0 and forloop.index0 > carousel_index
                  assign panel_position = 'right'
                endif
                assign hero_image_width_class = 'w-1/2'
                if image_block_count == 1
                  assign hero_image_width_class = 'w-full md:w-1/2'
                endif
                assign hero_image_panel_classes = hero_image_width_class | append: ' h-full md:h-full md:flex-[1_1_0] md:min-w-0 overflow-hidden'
                if panel_position == 'right'
                  assign hero_image_panel_classes = hero_image_panel_classes | append: ' md:order-3'
                else
                  assign hero_image_panel_classes = hero_image_panel_classes | append: ' md:order-1'
                endif
              %}
              <div class="{{ hero_image_panel_classes }} hero-image-panel">
                {% render 'theme-image-block', block: per_block, layout: 'cover' %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% for per_block in section.blocks %}
        {% if per_block.type == 'zc_theme__carousel' %}
          {% liquid
            assign hero_carousel_layout = 'hero'
            if image_block_count == 0
              assign hero_carousel_layout = 'hero_full'
            elsif image_block_count == 1
              assign hero_carousel_layout = 'hero_split'
            endif
          %}
          {% render 'theme-carousel', block: per_block, layout: hero_carousel_layout, carousel_mobile_order: carousel_mobile_order %}
        {% endif %}
      {% endfor %}

      {% if section.blocks.size == 0 %}
        <p class="body-text-color text-sm text-center py-8 w-full">{{ 'sections.hero_banner.empty' | t }}</p>
      {% endif %}
    </div>
  </div>
</section>

