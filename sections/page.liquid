<div id="section-{{ section.id }}" class="w-[90%] mx-auto page-max-width md:pt-12 pb-12 px-6 md:px-10 lg:px-0">
  <div class="px-0 my-4 lg:my-8">
    <div class="lg:w-3/4 w-full mx-auto">
      <h1 class="text-2xl md:text-3xl font-bold text-center my-4 lg:my-8 primary-font heading-text-color uppercase tracking-tight">
        {{ page.title | escape }}
      </h1>
      <div class="blog-content text-base md:text-lg leading-relaxed my-4 lg:my-8 min-h-96 body-text-color">
        {{ page.content }}
      </div>
    </div>
  </div>
  {% assign summary_product = section.settings.summary_product %}
  {% if summary_product.handle != blank %}
    <div class="lg:w-3/4 w-full mx-auto my-6">
      {% render 'product-summary', product: summary_product, show_price: section.settings.show_price %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:sections.page.name",
  "available_in": { "templates": ["page"] },
  "settings": [
    {
      "type": "product",
      "id": "summary_product",
      "label": "Product summary product",
      "default": { "handle": "" }
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show product price",
      "default": true
    }
  ],
  "presets": [{ "name": "Page" }]
}
{% endschema %}
