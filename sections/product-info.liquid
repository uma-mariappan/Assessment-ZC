<script src="{{ 'product-details-tabs-602320888380564.js' | asset_url }}" defer></script>
<script type="module" src="{{ 'reviews-ratings-423229591876198.js' | asset_url }}" defer></script>

{% style %}
  #section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }
  @media (min-width: 768px) {
    #section-{{ section.id }} {
      padding-top: {{ section.settings.desktop_padding_top }}px;
      padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    }
  }
{% endstyle %}

{% liquid
  assign section_settings = section.settings
  assign bg_color = section_settings.background_color.value | default: 'primary'
%}

<section id="section-{{ section.id }}" class="w-full {% if bg_color == 'primary' %}primary-bg-color{% else %}secondary-bg-color{% endif %}">
  <div class="w-[90%] mx-auto page-max-width">
    {% render 'product-info', product: product, block_settings: section_settings, currency: currency %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.product_info.name",
  "tag": "section",
  "class": "section",
  "available_in": {"templates": ["product"]},
  "settings": [
    {
      "type": "select",
      "id": "background_color",
      "label": "t:sections.product_info.settings.background_color.label",
      "options": [
        { "label": "t:sections.product_info.settings.background_color.option__1.label", "value": "primary" },
        { "label": "t:sections.product_info.settings.background_color.option__2.label", "value": "secondary" }
      ],
      "default": { "display_name": "t:sections.product_info.settings.background_color.default", "value": "primary" }
    },
    {
      "type": "text",
      "id": "description_title",
      "label": "t:sections.product_info.settings.description_title.label",
      "default": "t:sections.product_info.settings.description_title.default"
    },
    {
      "type": "text",
      "id": "specification_title",
      "label": "t:sections.product_info.settings.specification_title.label",
      "default": "t:sections.product_info.settings.specification_title.default"
    },
    {
      "type": "text",
      "id": "custom_fields_title",
      "label": "t:sections.product_info.settings.custom_fields_title.label",
      "default": "t:sections.product_info.settings.custom_fields_title.default"
    },
    {
      "type": "header",
      "content": "t:sections.product_info.settings.section_padding.mobile",
      "meta": "mobile"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 30,
      "label": "t:sections.product_info.settings.section_padding.top.label",
      "meta": "mobile"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 30,
      "label": "t:sections.product_info.settings.section_padding.bottom.label",
      "meta": "mobile"
    },
    {
      "type": "header",
      "content": "t:sections.product_info.settings.section_padding.desktop",
      "meta": "desktop"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30,
      "label": "t:sections.product_info.settings.section_padding.top.label",
      "meta": "desktop"
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30,
      "label": "t:sections.product_info.settings.section_padding.bottom.label",
      "meta": "desktop"
    }
  ],
  "presets": [{ "name": "t:sections.product_info.presets.default.name" }]
}
{% endschema %}
