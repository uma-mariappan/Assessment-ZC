{% liquid
  assign section_settings = section.settings
  assign content_alignment = section_settings.content_alignment.value | default: section_settings.content_alignment | default: 'bottom'
  assign image_alignment = section_settings.image_alignment.value | default: section_settings.image_alignment | default: 'center'
  assign text_alignment = section_settings.text_alignment.value | default: section_settings.text_alignment | default: 'center'
  assign bg_type = section_settings.background_color.value | default: section_settings.background_color | default: 'primary'
  assign banner_image_object = section_settings.back_image
  assign banner_image_url = banner_image_object.url

  assign content_vertical_class = 'justify-center'
  if content_alignment == 'top'
    assign content_vertical_class = 'justify-start pt-12'
  elsif content_alignment == 'bottom'
    assign content_vertical_class = 'justify-end pb-8 md:pb-12'
  endif

  assign text_alignment_class = 'items-center text-center'
  if text_alignment == 'left'
    assign text_alignment_class = 'items-start text-left'
  elsif text_alignment == 'right'
    assign text_alignment_class = 'items-end text-right'
  endif

  assign image_position_class = 'justify-center'
  if image_alignment == 'left'
    assign image_position_class = 'justify-start'
  elsif image_alignment == 'right'
    assign image_position_class = 'justify-end'
  endif

  assign banner_alt_text = banner_image_object.alt
  if banner_alt_text == blank
    assign banner_alt_text = 'sections.shop_now_banner.image_alt' | t
  endif

  assign has_banner_image = false
  if banner_image_url != blank and banner_image_url != '?'
    assign has_banner_image = true
  endif

%}

{% style %}
  #section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }
  @media (min-width: 768px) {
    #section-{{ section.id }} {
      padding-top: {{ section.settings.desktop_padding_top }}px;
      padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    }
  }
  #section-{{ section.id }} .shop-now-banner__stage {
    min-height: 280px;
  }
  #section-{{ section.id }} .shop-now-banner__image-layer {
    pointer-events: none;
  }
  #section-{{ section.id }} .shop-now-banner__image-layer picture {
    display: block;
    width: 155px;
    height: auto;
  }
  #section-{{ section.id }} .shop-now-banner__image-layer img {
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: center bottom;
  }
  #section-{{ section.id }} .shop-now-banner__content .theme-text-block {
    width: 100%;
  }
  @media (min-width: 768px) {
    #section-{{ section.id }} .shop-now-banner__stage {
      min-height: 623px;
    }
    #section-{{ section.id }} .shop-now-banner__image-layer picture {
      width: 495px;
    }
  }
{% endstyle %}

<section id="section-{{ section.id }}" class="w-full {% if bg_type == 'secondary' %}bg-secondary-color{% else %}bg-primary-color{% endif %}">
  <div class="shop-now-banner__stage relative w-full overflow-hidden flex flex-col">
    <div
      class="absolute left-1/2 -translate-x-1/2 bottom-0 w-[90%] page-max-width z-[1] pointer-events-none"
      style="height: {{ section_settings.container_bg_height }}%; background-color: {{ section_settings.container_bg_color }};"
    ></div>

    {% if has_banner_image %}
      <div class="shop-now-banner__image-layer absolute left-1/2 -translate-x-1/2 bottom-0 w-[90%] page-max-width z-[3] flex items-end {{ image_position_class }}">
        <picture class="block">
          {% render 'image-resolutions', firstImage: banner_image_object %}
          <img
            src="{{ banner_image_url }}"
            alt="{{ banner_alt_text | escape }}"
            width="495"
            height="623"
            loading="eager"
            fetchpriority="high"
            class="shop-now-banner__image-img">
        </picture>
      </div>
    {% endif %}

    {% if section_settings.bottom_gradient_height > 0 %}
      <div
        class="absolute left-1/2 -translate-x-1/2 bottom-0 w-[90%] page-max-width z-[4] pointer-events-none"
        style="height: {{ section_settings.bottom_gradient_height }}%; background: linear-gradient(to top, {{ section_settings.bottom_gradient_color }} 0%, rgba(255,255,255,0) 100%);"
      ></div>
    {% endif %}

    <div class="shop-now-banner__content relative z-[5] flex flex-col flex-1 gap-4 md:gap-6 py-10 md:py-24 px-20 w-[90%] page-max-width mx-auto {{ content_vertical_class }} {{ text_alignment_class }}">
      {% render_blocks %}
    </div>
  </div>
</section>

