<script src="{{ 'testimonial-slider-400775016324488.js' | asset_url }}" defer></script>

{% liquid
  assign section_settings = section.settings
  assign alignment = section_settings.content_alignment.value | default: section_settings.content_alignment | default: 'center'
  assign ts_bg_value = section_settings.background_color.value | default: section_settings.background_color | default: 'primary'
%}

{% style %}
  #section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }
  @media (min-width: 768px) {
    #section-{{ section.id }} {
      padding-top: {{ section.settings.desktop_padding_top }}px;
      padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    }
  }
  #section-{{ section.id }} [data-testimonial-track] {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  #section-{{ section.id }} [data-testimonial-track]::-webkit-scrollbar {
    display: none;
  }
  #section-{{ section.id }} .ts-scrollbar-track {
    background-color: rgba(var(--border-color), 0.2);
  }
  #section-{{ section.id }} .ts-scrollbar-thumb {
    background-color: var(--heading-text-color);
  }
  #section-{{ section.id }} .testimonial-card-hover {
    border: 1px solid transparent;
    transition: border-color 0.3s ease;
  }
  #section-{{ section.id }} .testimonial-card-hover:hover,
  #section-{{ section.id }} .testimonial-card-hover:focus-within {
    border-color: var(--heading-text-color);
  }
  #section-{{ section.id }} .testimonial-card-hover:hover .testimonial-product-bar,
  #section-{{ section.id }} .testimonial-card-hover:focus-within .testimonial-product-bar {
    background-color: var(--hover-bg);
  }
{% endstyle %}

<testimonial-slider id="section-{{ section.id }}" class="block w-full {% if ts_bg_value == 'secondary' %}bg-secondary-color{% else %}bg-primary-color{% endif %}">
  <div class="w-[90%] page-max-width mx-auto">
    {% assign has_testimonial_card = false %}

    <div class="w-full flex flex-col gap-4 md:gap-6 {% if alignment == 'left' %}items-start text-left{% elsif alignment == 'right' %}items-end text-right{% else %}items-center text-center{% endif %} mb-10 md:mb-12">
      {% render_blocks %}
    </div>

    <div data-testimonial-instance>
      <div
        data-testimonial-track
        tabindex="-1"
        class="flex gap-4 md:gap-6 overflow-x-auto overflow-y-hidden pb-2 scroll-smooth snap-x snap-mandatory"
      >
        {% for perBlock in section.blocks %}
          {% if perBlock.type == 'testimonial-card' %}
            {% assign has_testimonial_card = true %}
            <article class="relative flex-shrink-0 snap-start w-[84vw] sm:w-[380px] lg:w-[400px] content-container content-container-color card p-5 md:p-7 group overflow-hidden testimonial-card-hover" {{ perBlock.zcommerce_attributes }}>
              {% render 'testimonial-card', testimonial_block: perBlock %}
            </article>
          {% endif %}
        {% endfor %}
      </div>

      {% if has_testimonial_card %}
        <div class="ts-scrollbar-track mt-6 h-[2px] relative hidden" data-testimonial-scrollbar>
          <div class="ts-scrollbar-thumb absolute top-0 left-0 h-[2px]" style="width: 40%; left: 0;" data-testimonial-scroll-thumb></div>
        </div>
      {% else %}
        <p class="text-center heading-text-color opacity-70 py-10">
          Add at least one Testimonial card block.
        </p>
      {% endif %}
    </div>
  </div>
</testimonial-slider>

