{% style %}
  #section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }
  @media (min-width: 768px) {
    #section-{{ section.id }} {
      padding-top: {{ section.settings.desktop_padding_top }}px;
      padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    }
  }
  #section-{{ section.id }} .video-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  #section-{{ section.id }} .video-scroll::-webkit-scrollbar {
    display: none;
  }
{% endstyle %}

{% liquid
  assign section_settings = section.settings
  assign svs_bg_value = section_settings.background_color.value | default: section_settings.background_color | default: 'primary'
%}

<section id="section-{{ section.id }}" class="w-full {% if svs_bg_value == 'secondary' %}bg-secondary-color{% else %}bg-primary-color{% endif %}">
  <div class="w-[90%] page-max-width mx-auto">
    <div class="text-center mb-8 md:mb-10">
      {% render_blocks %}
    </div>

    {% assign video_block_count = 0 %}
    {% for perBlock in section.blocks %}
      {% if perBlock.type == 'video' %}
        {% assign video_block_count = video_block_count | plus: 1 %}
      {% endif %}
    {% endfor %}

    <div class="video-scroll flex {% if video_block_count >= 4 %}justify-between{% else %}justify-center{% endif %} gap-3 md:gap-5 overflow-x-auto">
      {% for perBlock in section.blocks %}
        {% if perBlock.type == 'video' %}
          <div class="flex-shrink-0 w-[180px] md:w-[309px]" {{ perBlock.zcommerce_attributes }}>
            {% render 'video-card', video_block: perBlock %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

