{% liquid
  assign block_settings = perBlock.settings
  assign question_text_color = block_settings.question_text_color.value
  assign answer_text_color = block_settings.answer_text_color.value
  assign faq_panel_id = 'faq-answer-' | append: perBlock.id
%}

<div class="rounded-[20px] overflow-hidden transition-all duration-300 faq-card bg-white" style="border: 1.5px solid #FDF2F8;" {{ perBlock.zcommerce_attributes }}>
  <div class="flex flex-col expand-options">
    <button type="button"
            class="flex items-center justify-between w-full text-left px-8 md:px-10 py-5 md:py-6 rounded-t-[20px] transition-colors duration-300 faq-header"
            data-trigger
            aria-expanded="false"
            aria-controls="{{ faq_panel_id }}">
      <span class="flex font-semibold text-sm md:text-base leading-[22px] items-center {% if question_text_color == 'heading-text-color' %} heading-text-color {% elsif question_text_color == 'alt-text-color' %} alt-text-color {% else %} body-text-color {% endif %}" style="letter-spacing: 0.3px;">
        {{ block_settings.question }}
      </span>
      <span class="flex-shrink-0 ml-4">
        <span data-expand-option class="w-8 h-8 md:w-9 md:h-9 rounded-full border flex items-center justify-center heading-text-color" style="border-color: var(--heading-text-color);" aria-hidden="true">
          {% render 'icon-plus-black' %}
        </span>
        <span data-collapse-option class="hidden w-8 h-8 md:w-9 md:h-9 rounded-full border flex items-center justify-center heading-text-color" style="border-color: var(--heading-text-color);" aria-hidden="true">
          {% render 'icon-minus-black' %}
        </span>
      </span>
    </button>
    <div id="{{ faq_panel_id }}" data-descp class="max-h-0 opacity-0 overflow-hidden transition-all duration-300" role="region">
      <div class="px-8 md:px-10 py-8 md:py-10">
        <p class="text-sm md:text-base font-normal leading-[26px] {% if answer_text_color == 'heading-text-color' %} heading-text-color {% elsif answer_text_color == 'alt-text-color' %} alt-text-color {% else %} body-text-color {% endif %}">
          {{ block_settings.answer }}
        </p>
      </div>
    </div>
  </div>
</div>
