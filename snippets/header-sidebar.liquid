<aside id="headerSidebar" data-header-sidebar class="hidden fixed left-0 bottom-0 w-full bg-white shadow-md z-50 overflow-hidden flex flex-col"
    style="top: var(--header-bottom, 4rem);"
    role="dialog" aria-modal="false" aria-label="Main menu">

    <currency-converter class="flex-1 flex flex-col overflow-hidden">

        <div data-main-view class="flex-1 flex flex-col overflow-y-auto">

            {% if org.customer_portal.enabled %}
                <div id="mobileBeforeSignIn" class="hidden items-center justify-between px-5 py-4 border-b"
                    style="border-color: var(--color-border); color: var(--color-text);">
                    <div class="flex items-center gap-3 text-sm font-medium min-w-0">
                        <span class="flex items-center justify-center w-9 h-9 rounded-full shrink-0" style="background-color: #D9D9D9;">
                            {% render "icon-profile-photo" %}
                        </span>
                        <span class="flex items-center gap-2 whitespace-nowrap">
                            <a href="/signin" class="hover:underline">{{ "header.sign_in" | t }}</a>
                            {% if org.customer_portal.signup_enabled %}
                                <span style="color: var(--color-border);">|</span>
                                <a href="/signup" class="hover:underline">{{ "header.sign_up" | t }}</a>
                            {% endif %}
                        </span>
                    </div>
                    <a href="/signin" aria-label="{{ 'header.sign_in' | t }}" style="color: var(--color-text);">{% render "icon-greater-than" %}</a>
                </div>

                <button type="button" id="mobileAfterSignIn" data-sidebar-open-profile
                    class="hidden w-full items-center justify-between px-5 py-4 border-b hover:bg-gray-50 text-left"
                    style="border-color: var(--color-border); color: var(--color-text);"
                    aria-label="Open account details">
                    <span class="flex items-center gap-3 text-sm font-medium">
                        <span class="flex items-center justify-center w-9 h-9 rounded-full" style="background-color: #D9D9D9;">
                            {% render "icon-profile-photo" %}
                        </span>
                        <span>{{ "header.hello" | t }} <span data-mobile-user-name></span></span>
                    </span>
                    <span style="color: var(--color-text);">{% render "icon-greater-than" %}</span>
                </button>
            {% endif %}

            {% if menubarlist.size > 0 %}
                <div class="border-b flex flex-col" data-header-menu-list style="border-color: var(--color-border);">
                    {% for menu in menubarlist %}
                        {% assign menu_slug = menu.name | default: '' | downcase | strip | replace: ' ', '-' | replace: '&', 'and' %}
                        {% capture menu_key %}menu-{{ menu_slug }}{% endcapture %}
                        {% if menu.child_items.size > 0 %}
                            <button type="button" data-sidebar-open-menu="{{ menu_key }}"
                                class="flex w-full items-center justify-between px-5 py-4 text-left hover:bg-gray-50"
                                style="color: var(--color-text);">
                                <span class="text-base font-semibold">{{ menu.name | escape }}</span>
                                <span style="color: var(--color-text);">{% render "icon-greater-than" %}</span>
                            </button>
                        {% else %}
                            <a href="{{ menu.url }}"
                                class="flex w-full items-center justify-between px-5 py-4 hover:bg-gray-50"
                                style="color: var(--color-text);">
                                <span class="text-base font-semibold">{{ menu.name | escape }}</span>
                            </a>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}

            <button type="button" data-open-currency-view
                class="flex w-full items-center justify-between px-5 py-4 border-b hover:bg-gray-50 text-left"
                style="border-color: var(--color-border); color: var(--color-text);"
                aria-label="Change currency">
                <span class="flex items-center gap-2 text-sm font-medium">
                    <span data-currency-label>Select currency</span>
                </span>
                <span style="color: var(--color-text);">{% render "icon-greater-than" %}</span>
            </button>

            {% if org.phone != "" and org.phone != null %}
                <a href="tel:{{ org.phone | escape }}"
                    class="flex items-center gap-3 px-5 py-4 border-b text-sm hover:bg-gray-50"
                    style="border-color: var(--color-border); color: var(--color-text);">
                    <span class="flex items-center">{% render "icon-phone" %}</span>
                    <span>{{ org.phone | escape }}</span>
                </a>
            {% endif %}

            {% if org.email != "" and org.email != null %}
                <a href="mailto:{{ org.email | escape }}"
                    class="flex items-center gap-3 px-5 py-4 border-b text-sm hover:bg-gray-50"
                    style="border-color: var(--color-border); color: var(--color-text);">
                    <span class="flex items-center">{% render "icon-mail" %}</span>
                    <span>{{ org.email | escape }}</span>
                </a>
            {% endif %}

            {% if org.social_profiles.size > 0 %}
                <div class="px-5 py-4">
                    <div class="flex flex-row gap-4 flex-wrap items-center" style="color: var(--color-text);">
                        {% for social in org.social_profiles %}
                            <a href="{{ social.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ social.name | escape }}">
                                {% render social.icon_snippet %}
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>

        <div data-currency-view class="hidden absolute inset-0 bg-white flex-col overflow-hidden z-10">
            <div class="flex items-center gap-3 px-5 py-4 border-b" style="border-color: var(--color-border);">
                <button type="button" data-currency-back class="cursor-pointer p-1" aria-label="Back" style="color: var(--color-text);">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
                <h2 class="text-base font-semibold" style="color: var(--color-text);">Currency</h2>
            </div>
            <ul data-currency-list class="flex-1 overflow-y-auto" role="radiogroup" aria-label="Currency options">
                <li class="px-5 py-4 text-sm" style="color: var(--color-text);" data-currency-empty>Loading…</li>
            </ul>
            <div class="p-5 border-t" style="border-color: var(--color-border);">
                <button type="button" data-currency-apply
                    class="btn-primary btn-primary-color btn-primary-hover w-full flex items-center justify-between px-6 py-4 text-sm font-semibold tracking-wide disabled:cursor-not-allowed">
                    <span>APPLY</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
            </div>
        </div>

        <select data-currency-trigger class="hidden" aria-hidden="true" tabindex="-1"></select>
    </currency-converter>

    {% for menu in menubarlist %}
        {% assign menu_slug = menu.name | default: '' | downcase | strip | replace: ' ', '-' | replace: '&', 'and' %}
        {% capture menu_key %}menu-{{ menu_slug }}{% endcapture %}
        {% if menu.child_items.size > 0 %}
            <div data-sidebar-menu-view="{{ menu_key }}" class="hidden absolute inset-0 bg-white flex-col overflow-y-auto z-20">
                <div class="flex items-center gap-3 px-5 py-4 border-b" style="border-color: var(--color-border);">
                    <button type="button" data-sidebar-menu-back class="cursor-pointer p-1" aria-label="Back" style="color: var(--color-text);">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    <h2 class="text-base font-semibold" style="color: var(--color-text);">{{ menu.name | escape }}</h2>
                </div>
                {% for child in menu.child_items %}
                    {% assign child_slug = child.name | default: '' | downcase | strip | replace: ' ', '-' | replace: '&', 'and' %}
                    {% capture child_key %}{{ menu_key }}-{{ child_slug }}{% endcapture %}
                    {% if child.child_items.size > 0 %}
                        <button type="button" data-sidebar-open-menu="{{ child_key }}"
                            class="flex w-full items-center justify-between px-5 py-4 border-b text-left hover:bg-gray-50"
                            style="border-color: var(--color-border); color: var(--color-text);">
                            <span class="text-sm">{{ child.name | escape }}</span>
                            <span style="color: var(--color-text);">{% render "icon-greater-than" %}</span>
                        </button>
                    {% else %}
                        <a href="{{ child.url }}"
                            class="flex w-full items-center justify-between px-5 py-4 border-b hover:bg-gray-50"
                            style="border-color: var(--color-border); color: var(--color-text);">
                            <span class="text-sm">{{ child.name | escape }}</span>
                            <span style="color: var(--color-text);">{% render "icon-greater-than" %}</span>
                        </a>
                    {% endif %}
                {% endfor %}
            </div>

            {% for child in menu.child_items %}
                {% assign child_slug = child.name | default: '' | downcase | strip | replace: ' ', '-' | replace: '&', 'and' %}
                {% capture child_key %}{{ menu_key }}-{{ child_slug }}{% endcapture %}
                {% if child.child_items.size > 0 %}
                    <div data-sidebar-menu-view="{{ child_key }}" class="hidden absolute inset-0 bg-white flex-col overflow-y-auto z-20">
                        <div class="flex items-center gap-3 px-5 py-4 border-b" style="border-color: var(--color-border);">
                            <button type="button" data-sidebar-menu-back class="cursor-pointer p-1" aria-label="Back" style="color: var(--color-text);">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                            <h2 class="text-base font-semibold" style="color: var(--color-text);">{{ child.name | escape }}</h2>
                        </div>
                        {% for sub in child.child_items %}
                            {% assign sub_slug = sub.name | default: '' | downcase | strip | replace: ' ', '-' | replace: '&', 'and' %}
                            {% capture sub_key %}{{ child_key }}-{{ sub_slug }}{% endcapture %}
                            {% if sub.child_items.size > 0 %}
                                <button type="button" data-sidebar-open-menu="{{ sub_key }}"
                                    class="flex w-full items-center justify-between px-5 py-4 border-b text-left hover:bg-gray-50"
                                    style="border-color: var(--color-border); color: var(--color-text);">
                                    <span class="text-sm">{{ sub.name | escape }}</span>
                                    <span style="color: var(--color-text);">{% render "icon-greater-than" %}</span>
                                </button>
                            {% else %}
                                <a href="{{ sub.url }}"
                                    class="flex w-full items-center justify-between px-5 py-4 border-b hover:bg-gray-50"
                                    style="border-color: var(--color-border); color: var(--color-text);">
                                    <span class="text-sm">{{ sub.name | escape }}</span>
                                    <span style="color: var(--color-text);">{% render "icon-greater-than" %}</span>
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>

                    {%- comment -%} Level-3 views (grand-children of the top menu) {%- endcomment -%}
                    {% for sub in child.child_items %}
                        {% assign sub_slug = sub.name | default: '' | downcase | strip | replace: ' ', '-' | replace: '&', 'and' %}
                        {% capture sub_key %}{{ child_key }}-{{ sub_slug }}{% endcapture %}
                        {% if sub.child_items.size > 0 %}
                            <div data-sidebar-menu-view="{{ sub_key }}" class="hidden absolute inset-0 bg-white flex-col overflow-y-auto z-20">
                                <div class="flex items-center gap-3 px-5 py-4 border-b" style="border-color: var(--color-border);">
                                    <button type="button" data-sidebar-menu-back class="cursor-pointer p-1" aria-label="Back" style="color: var(--color-text);">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                            <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </button>
                                    <h2 class="text-base font-semibold" style="color: var(--color-text);">{{ sub.name | escape }}</h2>
                                </div>
                                {% for grand in sub.child_items %}
                                    <a href="{{ grand.url }}"
                                        class="flex w-full items-center justify-between px-5 py-4 border-b hover:bg-gray-50"
                                        style="border-color: var(--color-border); color: var(--color-text);">
                                        <span class="text-sm">{{ grand.name | escape }}</span>
                                        <span style="color: var(--color-text);">{% render "icon-greater-than" %}</span>
                                    </a>
                                {% endfor %}
                            </div>
                        {% endif %}
                    {% endfor %}
                {% endif %}
            {% endfor %}
        {% endif %}
    {% endfor %}

    {% if org.customer_portal.enabled %}
        <div data-sidebar-profile-view class="hidden absolute inset-0 bg-white flex-col overflow-y-auto z-20">
            <div class="flex items-center gap-3 px-5 py-4 border-b" style="border-color: var(--color-border);">
                <button type="button" data-sidebar-profile-back class="cursor-pointer p-1" aria-label="Back" style="color: var(--color-text);">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
                <span class="flex items-center justify-center w-11 h-11 rounded-full shrink-0" style="background-color: #D9D9D9;">
                    {% render "icon-profile-photo" %}
                </span>
                <div class="flex flex-col min-w-0">
                    <span class="text-base font-semibold truncate" style="color: var(--color-text);" data-mobile-user-name></span>
                </div>
            </div>
            <a href="/account/profile" class="flex items-center justify-between px-5 py-4 border-b hover:bg-gray-50" style="border-color: var(--color-border); color: var(--color-text);">
                <span class="text-sm font-medium">{{ "header.my_profile" | t }}</span>
                <span style="color: var(--color-text);">{% render "icon-greater-than" %}</span>
            </a>
            <a href="/account/orders" class="flex items-center justify-between px-5 py-4 border-b hover:bg-gray-50" style="border-color: var(--color-border); color: var(--color-text);">
                <span class="text-sm font-medium">{{ "header.my_orders" | t }}</span>
                <span style="color: var(--color-text);">{% render "icon-greater-than" %}</span>
            </a>
            <a href="/account/addresses" class="flex items-center justify-between px-5 py-4 border-b hover:bg-gray-50" style="border-color: var(--color-border); color: var(--color-text);">
                <span class="text-sm font-medium">{{ "header.my_addresses" | t }}</span>
                <span style="color: var(--color-text);">{% render "icon-greater-than" %}</span>
            </a>
            {% if org.customer_portal.enabled and org.preferences.is_wishlist_enabled and org.preferences.is_quotes_enabled %}
                <a href="/wishlists" class="flex items-center justify-between px-5 py-4 border-b hover:bg-gray-50" style="border-color: var(--color-border); color: var(--color-text);">
                    <span class="text-sm font-medium">{{ "header.my_wishlist" | t }}</span>
                    <span style="color: var(--color-text);">{% render "icon-greater-than" %}</span>
                </a>
            {% endif %}
            {% if org.customer_portal.enabled and org.preferences.is_quotes_enabled %}
                <a href="/account/quotes" class="flex items-center justify-between px-5 py-4 border-b hover:bg-gray-50" style="border-color: var(--color-border); color: var(--color-text);">
                    <span class="text-sm font-medium">{{ 'accounts.common.my_quotes' | t }}</span>
                    <span style="color: var(--color-text);">{% render "icon-greater-than" %}</span>
                </a>
            {% endif %}
            <a data-signout-url href="#" class="flex items-center justify-between px-5 py-4 border-b hover:bg-gray-50" style="border-color: var(--color-border); color: var(--color-text);">
                <span class="text-sm font-medium">{{ "header.sign_out" | t }}</span>
                <span style="color: var(--color-text);">{% render "icon-greater-than" %}</span>
            </a>
        </div>
    {% endif %}
</aside>

<div data-sidebar-overlay class="hidden fixed inset-x-0 bottom-0 bg-black bg-opacity-50 z-40" style="top: var(--header-bottom, 4rem);"></div>
