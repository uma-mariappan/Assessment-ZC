{% liquid
  assign quotes_enabled = false
  if store.customer_portal.enabled and store.preferences.is_quotes_enabled
    assign quotes_enabled = true
  endif
%}
<script type="module" src="{{ 'quick-view-492041322519430.js' | asset_url }}" defer></script>
<script type="module" src="{{ 'add-to-cart-514496733357978.js' | asset_url }}" defer></script>
<script src="{{ 'quantity-counter-176141763398130.js' | asset_url }}" defer></script>
<script src="{{ 'variant-radios-80014417361969.js' | asset_url }}" defer></script>
{% if quotes_enabled %}
<script type="module" src="{{ 'request-quote-571332105730115.js' | asset_url }}" defer></script>
{% endif %}

<quick-view class="contents" data-product-id="{{ perProduct.id }}">

    <div class="qv-trigger-wrapper hidden md:block absolute bottom-6 left-6 right-6 opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 focus-within:opacity-100 focus-within:translate-y-0 transition-all duration-300 ease-in-out z-10">
        <button type="button" data-quick-view-button data-product-id="{{ perProduct.id }}"
            class="flex items-center justify-center w-full py-3 btn-primary-color text-sm font-normal tracking-wide rounded-sm"
            style="background-color: var(--heading-text-color);"
            aria-label="Quick view {{ perProduct.title | escape }}">
            Quick view
        </button>
    </div>

    <div data-quick-view-modal class="qv-modal hidden fixed inset-0 z-[90]">
        <div data-quick-view-backdrop class="absolute inset-0 bg-black bg-opacity-75"></div>
        <div class="absolute inset-0 flex items-center justify-center p-4 overflow-y-auto">
            <div data-quick-view data-quick-view-content class="qv-content relative w-full md:w-[967px] md:h-[578px] max-w-[967px] md:max-h-[578px] overflow-hidden bg-white"></div>
        </div>
    </div>
</quick-view>
