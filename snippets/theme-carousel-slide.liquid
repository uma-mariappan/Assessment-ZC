{% liquid
  assign block_settings = block.settings
  assign slide_index = slide_index | default: 0
  assign show_background_image = block_settings.show_background_image
  assign background_image = block_settings.background_image
  assign content_alignment = block_settings.content_alignment.value | default: block_settings.content_alignment | default: 'center'
  assign content_layout = block_settings.content_layout.value | default: block_settings.content_layout | default: 'standard'
  assign overlay_color = block_settings.overlay_color | default: '#000000'
  assign overlay_opacity = block_settings.overlay_opacity | default: 30 | divided_by: 100.0

  assign slide_classes = 'hero-carousel-slide flex-shrink-0 w-full h-full snap-start flex flex-col justify-center py-12 relative overflow-hidden'
  assign content_width_class = 'max-w-[300px] md:max-w-none'
  if content_layout == 'compact'
    assign content_width_class = 'max-w-[300px] md:max-w-[420px]'
  endif
  assign content_classes = 'flex flex-col gap-8 ' | append: content_width_class | append: ' relative z-[1]'

  if content_alignment == 'left'
    assign slide_classes = slide_classes | append: ' items-start text-left'
    assign content_classes = content_classes | append: ' items-start text-left px-6 md:px-12'
  elsif content_alignment == 'right'
    assign slide_classes = slide_classes | append: ' items-end text-right'
    assign content_classes = content_classes | append: ' items-end text-right px-6 md:px-12'
  else
    assign slide_classes = slide_classes | append: ' items-center text-center'
    assign content_classes = content_classes | append: ' items-center text-center mx-auto md:mx-0'
  endif

  if slide_index == 0
    assign slide_classes = slide_classes | append: ' active-hero-slide'
  endif

  assign background_alt = background_image.alt
  if background_alt == blank
    assign background_alt = 'common.alt_image' | t
  endif
%}
<div
  hero-slide-index="{{ slide_index }}"
  class="{{ slide_classes }}"
  {{ block.zcommerce_attributes }}>
  {% if show_background_image and background_image.url != blank %}
    <picture class="absolute inset-0 w-full h-full pointer-events-none">
      {% render 'image-resolutions', firstImage: background_image %}
      <img
        src="{{ background_image.url }}"
        alt="{{ background_alt | escape }}"
        width="{{ background_image.width | default: 592 }}"
        height="{{ background_image.height | default: 770 }}"
        loading="{% if slide_index == 0 %}eager{% else %}lazy{% endif %}"
        class="w-full h-full object-cover object-center">
    </picture>
  {% endif %}
  {% if block_settings.overlay_enabled %}
    <div
      class="absolute inset-0 z-0"
      aria-hidden="true"
      style="background-color: {{ overlay_color }}; opacity: {{ overlay_opacity }};">
    </div>
  {% endif %}
  <div class="{{ content_classes }}">
    {% if block_settings.eyebrow != blank %}
      <p class="hero-carousel-slide__eyebrow">{{ block_settings.eyebrow | escape }}</p>
    {% endif %}
    {% if block_settings.description != blank %}
      <div class="hero-carousel-slide__description">{{ block_settings.description }}</div>
    {% endif %}
    {% for child_block in block.blocks %}
      {% case child_block.type %}
        {% when 'zc_theme__text' %}
          <div class="hero-carousel-slide__text uppercase leading-tight">
            {% render 'theme-text-block', block: child_block %}
          </div>
        {% when 'zc_theme__button' %}
          {% render 'theme-button-block', block: child_block %}
      {% endcase %}
    {% else %}
        {% if block_settings.eyebrow == blank and block_settings.description == blank %}
          <p class="body-text-color text-sm">{{ 'blocks.carousel_slide.empty' | t }}</p>
        {% endif %}
    {% endfor %}
  </div>
</div>
