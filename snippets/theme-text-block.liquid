{% liquid
  assign block_settings = block.settings
  assign text_content = block_settings.text.value | default: block_settings.text
  assign text_color_setting = block_settings.select_text_color.value | default: block_settings.select_text_color

  if text_color_setting == blank
    assign text_color = 'heading-text-color'
  elsif text_color_setting == 'heading-text-color' or text_color_setting == 'heading'
    assign text_color = 'heading-text-color'
  elsif text_color_setting == 'body-text-color' or text_color_setting == 'body'
    assign text_color = 'body-text-color'
  elsif text_color_setting == 'alt-text-color' or text_color_setting == 'alternative' or text_color_setting == 'alt'
    assign text_color = 'alt-text-color'
  else
    assign text_color = 'heading-text-color'
  endif
  assign font_family = block_settings.select_font_family.value | default: block_settings.select_font_family | default: 'primary'
  assign mobile_text_size = block_settings.mobile_text_size.value | default: block_settings.mobile_text_size | default: 'text-base'
  assign desktop_text_size = block_settings.desktop_text_size.value | default: block_settings.desktop_text_size | default: 'text-base'
  assign mobile_font_weight = block_settings.mobile_font_weight.value | default: block_settings.mobile_font_weight | default: 'medium'
  assign desktop_font_weight = block_settings.desktop_font_weight.value | default: block_settings.desktop_font_weight | default: 'medium'

  case mobile_font_weight
    when 'light'
      assign mobile_font_weight_value = 300
    when 'bold'
      assign mobile_font_weight_value = 700
    else
      assign mobile_font_weight_value = 500
  endcase

  case desktop_font_weight
    when 'light'
      assign desktop_font_weight_value = 300
    when 'bold'
      assign desktop_font_weight_value = 700
    else
      assign desktop_font_weight_value = 500
  endcase
%}
{% if text_content != blank %}
  {% style %}
    #theme-block-text-{{ block.id }} .theme-text-block__content {
      box-sizing: border-box;
      max-width: 100%;
      padding-top: {{ block_settings.padding_block_start | default: 0 }}px;
      padding-bottom: {{ block_settings.padding_block_end | default: 0 }}px;
      padding-left: {{ block_settings.padding_inline_start | default: 0 }}px;
      padding-right: {{ block_settings.padding_inline_end | default: 0 }}px;
      font-weight: {{ mobile_font_weight_value }};
    }

    @media (min-width: 768px) {
      #theme-block-text-{{ block.id }} .theme-text-block__content {
        font-weight: {{ desktop_font_weight_value }};
      }
    }
  {% endstyle %}
  <div id="theme-block-text-{{ block.id }}" class="theme-text-block" {{ block.zcommerce_attributes }}>
    <div class="theme-text-block__content {{ mobile_text_size }} md:{{ desktop_text_size }}
      {% if font_family == 'primary' %} primary-font
      {% else %} secondary-font {% endif %}
      {% if text_color == 'heading-text-color' %} heading-text-color
      {% elsif text_color == 'body-text-color' %} body-text-color
      {% else %} alt-text-color {% endif %}">
      {{ text_content }}
    </div>
  </div>
{% endif %}
